    "machine_start_gcode": ";=== Northworks 600x — Klipper start (2026-08-14) ===\n; Heat/home/mesh/head-lock/tool-offsets all live in Klipper's PRINT_START\n; macro (macros-print.cfg). The slicer only passes targets.\nPRINT_START EXTRUDER={first_layer_temperature[initial_tool]} BED={first_layer_bed_temperature[initial_tool]} TOOL={initial_tool}\n; Preheat the second head (non-blocking) if this is a dual-material job.\n; NB dual prints stay blocked until the T1 Z tip delta is measured (_TH t1_z).\n{if is_extruder_used[0] and initial_tool != 0}M104 S{first_layer_temperature[0]} T0\n{endif}{if is_extruder_used[1] and initial_tool != 1}M104 S{first_layer_temperature[1]} T1\n{endif};=== end start ===",
    "change_filament_gcode": ";=== tool change -> T{next_extruder} ===\n; the Klipper T0/T1 macros do the z-hop, lift/lock choreography and offsets;\n; re-assert layer Z afterwards — the macro's +2 hop is NOT auto-restored\n; (mid-print changes would otherwise print in the air until the next layer)\nT{next_extruder}\nG1 Z{layer_z} F198",
    "machine_end_gcode": ";=== Northworks 600x — Klipper end ===\nPRINT_END",
    "layer_change_gcode": ";AFTER_LAYER_CHANGE\n;[layer_z]\nG92 E0\nTIMELAPSE_TAKE_FRAME",
    "before_layer_change_gcode": ";BEFORE_LAYER_CHANGE\n;[layer_z]\nG92 E0",
    "machine_pause_gcode": "M601"
